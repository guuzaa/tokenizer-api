{
  "name": "tokenizer-api",
  "private": true,
  "version": "0.0.1",
  "description": "An API for counting tokens",
  "author": "Jowell Young <guza@duck.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guuzaa/tokenizer-api"
  },
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "dev": "pnpm build:wasm && wrangler dev",
    "deploy": "pnpm build:wasm && wrangler deploy",
    "test": "pnpm build:wasm && vitest run",
    "bench": "pnpm build:wasm && node bench/workerd.mjs",
    "types": "wrangler types",
    "check": "pnpm build:wasm && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}